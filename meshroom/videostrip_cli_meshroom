#!/usr/bin/env bash
set -euo pipefail

# Prefer system BLAS/OpenBLAS before anything Meshroom bundles.
# If LD_PRELOAD already exists, append to it.
export LD_PRELOAD="/lib/x86_64-linux-gnu/libopenblas.so.0${LD_PRELOAD:+:$LD_PRELOAD}"

# Put system lib dirs first, then whatever was already there.
export LD_LIBRARY_PATH="/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu:/usr/local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# (Optional) uncomment for quick diagnostics:
# echo "[videostrip_cli_meshroom] args: $*" >&2
# env | grep -E 'LD_PRELOAD|LD_LIBRARY_PATH' >&2

# IMPORTANT: forward all args verbatim
exec -a videostrip_cli /usr/local/bin/videostrip_cli "$@"



